{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "cSpell.words": [
    "catchable",
    "chatcmpl",
    "fontawesome",
    "generativeexperiencesd",
    "koffi",
    "Llms",
    "Siri",
    "tsfm",
    "vitepress",
    "vitest"
  ],
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "native/bridge/LICENSE.md"
  ],
  "swift.autoGenerateLaunchConfigurations": false
}
