{
  "name": "tsfm-sdk",
  "version": "1.0.0-beta.1",
  "description": "Unofficial TypeScript bindings for Apple Foundation Models framework (Apple Intelligence on-device LLM)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codybrom/tsfm.git"
  },
  "bugs": {
    "url": "https://github.com/codybrom/tsfm/issues"
  },
  "homepage": "https://tsfm.dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsfm": "./dist/cli/doctor.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./chat": {
      "import": "./dist/compat/index.js",
      "types": "./dist/compat/index.d.ts"
    },
    "./openai": {
      "import": "./dist/compat/index.js",
      "types": "./dist/compat/index.d.ts"
    },
    "./system1": {
      "import": "./dist/system-one.js",
      "types": "./dist/system-one.d.ts"
    },
    "./jev": {
      "import": "./dist/system-one.js",
      "types": "./dist/system-one.d.ts"
    }
  },
  "scripts": {
    "build": "bash scripts/build-native.sh && tsc -p tsconfig.build.json && chmod +x dist/cli/doctor.js",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src/ tests/ examples/ scripts/",
    "lint:fix": "eslint src/ tests/ examples/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:sdk27": "bash -c '\"$(bash scripts/sdk27-node.sh)\" node_modules/vitest/vitest.mjs run --project integration \"$@\"' --",
    "test:integration:pcc": "TSFM_PCC_REQUIRE=1 bash -c '\"$(bash scripts/pcc-host.sh)\" node_modules/vitest/vitest.mjs run --project integration tests/integration/pcc.test.ts \"$@\"' --",
    "test:stress": "node --import tsx scripts/stress-tools.ts",
    "test:coverage": "vitest run --coverage",
    "example": "tsx scripts/run-example.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/",
    "native/libFoundationModels.dylib",
    "native/tsfm.node",
    "native/FoundationModels.h",
    "src/",
    "NOTICE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "openai": "^7.19.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
