{
  "name": "tsfm-sdk",
  "version": "0.4.0",
  "description": "Unofficial TypeScript bindings for Apple Foundation Models framework (Apple Intelligence on-device LLM)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codybrom/tsfm.git"
  },
  "bugs": {
    "url": "https://github.com/codybrom/tsfm/issues"
  },
  "homepage": "https://tsfm.dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./chat": {
      "import": "./dist/compat/index.js",
      "types": "./dist/compat/index.d.ts"
    }
  },
  "scripts": {
    "build": "bash scripts/build-native.sh && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src/ tests/ examples/ scripts/",
    "lint:fix": "eslint src/ tests/ examples/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "example": "tsx scripts/run-example.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/",
    "native/libFoundationModels.dylib",
    "native/FoundationModels.h",
    "src/",
    "NOTICE"
  ],
  "dependencies": {
    "koffi": "^3.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "openai": "^7.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "koffi@3.1.5": true,
    "esbuild@0.28.2": true
  }
}
