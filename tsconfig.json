{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "ESNext.Disposable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "tsfm-sdk": ["./src/index.ts"],
      "tsfm-sdk/chat": ["./src/compat/index.ts"],
      "tsfm-sdk/openai": ["./src/compat/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "examples/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
